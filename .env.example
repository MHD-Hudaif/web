# ========================================================
# AL MAQRA (المَقرَأ) - Example Environment Template
# Copy this file to .env and fill in your private credentials.
# ========================================================

# Application Details
APP_NAME="AL MAQRA"
APP_NAME_AR="المَقرَأ"
APP_TAGLINE="Learn. Recite. Reflect."
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://yourdomain.com/web"

# Database Connection (Webhost / cPanel / VPS)
DB_DRIVER="mysql"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="your_database_name"
DB_USER="your_database_user"
DB_PASS="your_secure_database_password"

# Academy Coordinator & WhatsApp Contact Routing
WHATSAPP_NUMBER="919497577616"
WHATSAPP_DISPLAY="+91 9497577616"
OFFICIAL_EMAIL="info@yourdomain.com"
INSTAGRAM_URL="https://www.instagram.com/reel/your_reel_id/"
WHATSAPP_CHANNEL_URL="https://whatsapp.com/channel/your_channel_id"

# Default Administrator Credentials (Initial Seeding)
DEFAULT_ADMIN_NAME="Admin Coordinator"
DEFAULT_ADMIN_EMAIL="admin@yourdomain.com"
DEFAULT_ADMIN_PASSWORD="change_this_to_a_strong_password"
